# Database
DATABASE_URL="mysql://cnids_user:changeme@localhost:3306/cnids_db"

# Server
PORT=4000
# Kosong = semua interface. 127.0.0.1 = hanya lewat reverse proxy lokal (nginx)
BIND_HOST=
NODE_ENV=development

# Sesi login (cookie httpOnly + tabel sessions di database; tidak lagi memakai JWT)
SESSION_TTL_HOURS=8
# lax (default, frontend & backend satu situs, mis. localhost beda port) | strict | none (beda domain; wajib HTTPS)
COOKIE_SAMESITE=lax
# Otomatis true di production. Set false hanya bila production masih lewat HTTP (tidak disarankan)
COOKIE_SECURE=

# Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR="./uploads"

# Monitoring pelengkap (opsional, lihat Proposal Bab 2.3 & src/utils/monitoring.js)
# Bawaan aktif. Isi false untuk mematikan ping otomatis. Jeda ping diatur per perangkat di form perangkat.
ENABLE_MONITORING_SCHEDULER=true

# Jumlah ping bersamaan (hindari ratusan ping + query sekaligus)
MONITOR_CONCURRENCY=10
# Retensi data (hari): riwayat ping dan peringatan yang sudah pulih dihapus otomatis tiap jam
STATUS_RETENTION_DAYS=30
ALERT_RETENTION_DAYS=180

# Ambang latensi ping (ms) BAWAAN untuk peringatan "Latensi tinggi"; Superadmin dapat mengubahnya di halaman Peringatan
ALERT_LATENCY_MS=200

# Keamanan
# Origin frontend yang diizinkan (dipisah koma). WAJIB di production. Contoh: https://cnids.kampus.ac.id
CORS_ORIGIN=
# Isi 1 bila backend berada di belakang satu reverse proxy tepercaya (Nginx/Cloudflare Tunnel), agar rate limit memakai IP asli
TRUST_PROXY=
# Batas permintaan (opsional)
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_LOGIN_PER_IP=20
RATE_LIMIT_LOGIN_PER_USER=5
